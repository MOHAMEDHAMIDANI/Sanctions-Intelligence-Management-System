# SECURITY NOTICE:
# All credentials and keys used in existing environments must be rotated before reuse.

# Application
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
SUPER_ADMIN_EMAIL=superadmin@example.com

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=sims_db

# Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200

# JWT Configuration
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION=1d

# Encryption Configuration
# Comma-separated 32-byte keys. The first key is used for new writes.
ENCRYPTION_KEYS=replace_with_32_char_key_1,replace_with_32_char_key_2

# SMTP Configuration
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp_user
SMTP_PASSWORD=change_me
MAIL_FROM="SIMS <no-reply@example.com>"

# Optional invite URL override
INVITE_URL_TEMPLATE=http://localhost:5173/confirm-account?token={{token}}
